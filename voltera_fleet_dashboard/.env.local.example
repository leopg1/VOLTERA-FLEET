# =============================================================
# Voltera Fleet Dashboard — env config
# Copy this file to .env.local and fill in your real values.
# =============================================================

# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon public key (Project Settings -> API -> anon public)
# NU folosi service_role aici — anon key e sigur sa fie expus.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# -------------------------------------------------------------
# Groq API key — pentru AI Copilot si Explica DTC (ambele user-invoked)
# (Llama 3.3 70B, free tier 30 req/min, fara card, ~200 tok/s)
# Cheie: https://console.groq.com/keys
# IMPORTANT: server-side only, fara prefix NEXT_PUBLIC_ (cheia NU ajunge in browser)
# -------------------------------------------------------------
GROQ_API_KEY=gsk_...
